-- 1. Xodimlar jadvalidan barcha noyob lavozimlar (job_title) ro'yxati:
SELECT DISTINCT job_title FROM employees;

-- 2. Mijozlar qaysi turlicha shaharlardan (city) ekanligi:
SELECT DISTINCT city FROM customers;

-- 3. Mijozlar joylashgan barcha noyob mamlakatlar (country) ro'yxati:
SELECT DISTINCT country FROM customers;

-- 4. Xodimlar oladigan barcha har xil maosh (salary) qiymatlari:
SELECT DISTINCT salary FROM employees;

-- 5. Buyurtmalar (Orders) jadvalidagi barcha noyob buyurtma sanalari (order_date):
SELECT DISTINCT order_date FROM orders;

-- 6. Xodimlar ishlaydigan barcha noyob bo'lim ID (dept_id) lari:
SELECT DISTINCT dept_id FROM employees;

-- 7. Xodimlar jadvalidagi barcha takrorlanmas ismlar (first_name):
SELECT DISTINCT first_name FROM employees;

-- 8. Mijozlar jadvalidagi barcha noyob statuslar (status):
SELECT DISTINCT status FROM customers;

-- 9. Buyurtmalar jadvalidagi barcha takrorlanmas summalar (total_amount):
SELECT DISTINCT total_amount FROM orders;

-- 10. Bir vaqtning o'zida ham shahar (city), ham mamlakat (country) bo'yicha noyob juftliklar:
SELECT DISTINCT city, country FROM customers;

-- 11. Xodimlarning ishga kirgan yillari bo'yicha noyob qiymatlar:
SELECT DISTINCT EXTRACT(YEAR FROM hire_date) FROM employees;

-- 12. Xodimlar va bo'limlar kesimida noyob dept_id va job_title juftliklari:
SELECT DISTINCT dept_id, job_title FROM employees;

-- 13. Buyurtma bergan barcha noyob customer_id lar:
SELECT DISTINCT customer_id FROM orders;

-- 14. Buyurtmalar jadvalidagi summalar qiymatini yaxlitlab, noyob summalar ro'yxati:
SELECT DISTINCT ROUND(total_amount) FROM orders;

-- 15. Ishga kirgan oylari (hire_date oy qismi) bo'yicha noyob ko'rsatkichlar:
SELECT DISTINCT EXTRACT(MONTH FROM hire_date) FROM employees;

-- 16. Mijozlarning statusi va mamlakati bo'yicha noyob kombinatsiyalari:
SELECT DISTINCT status, country FROM customers;

-- 17. Maosh (salary) va bo'lim (dept_id) bo'yicha noyob juftliklar:
SELECT DISTINCT salary, dept_id FROM employees;

-- 18. Xodimlarning familiyalaridagi noyob bosh harflar:
SELECT DISTINCT LEFT(last_name, 1) FROM employees;

-- 19. Bir xil maosh oladigan va bir xil bo'limda ishlaydigan noyob birikmalar:
SELECT DISTINCT salary, dept_id FROM employees;

-- 20. Buyurtma sanasi va customer_id bo'yicha noyob juftliklar:
SELECT DISTINCT order_date, customer_id FROM orders;

-- 21. Shahar nomi 5 harfdan uzun bo'lgan mijozlarning noyob shaharlari:
SELECT DISTINCT city FROM customers WHERE LENGTH(city) > 5;

-- 22. Maoshi 3000 dan yuqori bo'lgan xodimlarning noyob lavozimlari (job_title):
SELECT DISTINCT job_title FROM employees WHERE salary > 3000;

-- 23. 2023-yildan keyin ishga kirgan xodimlarning noyob dept_id lari:
SELECT DISTINCT dept_id FROM employees WHERE EXTRACT(YEAR FROM hire_date) > 2023;

-- 24. Status 'ACTIVE' bo'lgan mijozlarning noyob mamlakatlari:
SELECT DISTINCT country FROM customers WHERE status = 'ACTIVE';

-- 25. Total_amount 100 dan yuqori bo'lgan buyurtmalarning noyob sanalari:
SELECT DISTINCT order_date FROM orders WHERE total_amount > 100;

-- 26. Familiyasi 'S' harfidan boshlanadigan xodimlarning noyob lavozimlari:
SELECT DISTINCT job_title FROM employees WHERE last_name LIKE 'S%';

-- 27. Shahri 'Tashkent' yoki 'Samarkand' bo'lgan mijozlarning noyob statuslari:
SELECT DISTINCT status FROM customers WHERE city IN ('Tashkent', 'Samarkand');

-- 28. Maoshi 2000 va 5000 oralig'ida bo'lgan xodimlarning noyob maoshlari:
SELECT DISTINCT salary FROM employees WHERE salary BETWEEN 2000 AND 5000;

-- 29. Muayyan bo'limda (dept_id = 2) ishlaydigan xodimlarning noyob lavozimlari:
SELECT DISTINCT job_title FROM employees WHERE dept_id = 2;

-- 30. Buyurtma summasi 500 dan kam bo'lgan mijozlarning noyob customer_id lari:
SELECT DISTINCT customer_id FROM orders WHERE total_amount < 500;

-- 31. DISTINCT va COUNT birga ishlatib, nechta noyob lavozim borligini hisoblash:
SELECT COUNT(DISTINCT job_title) FROM employees;

-- 32. Nechta har xil shahar mijozlar jadvalida borligini DISTINCT yordamida sanash:
SELECT COUNT(DISTINCT city) FROM customers;

-- 33. Nechta noyob customer_id buyurtma berganini hisoblash:
SELECT COUNT(DISTINCT customer_id) FROM orders;

-- 34. Nechta noyob maosh miqdori mavjudligini sanash:
SELECT COUNT(DISTINCT salary) FROM employees;

-- 35. Nechta har xil mamlakat vakillari borligini aniqlash:
SELECT COUNT(DISTINCT country) FROM customers;

-- 36. Bo'limlar bo'yicha nechta noyob lavozimlar borligini sanash:
SELECT dept_id, COUNT(DISTINCT job_title) FROM employees GROUP BY dept_id;

-- 37. Qaysi yillarda xodimlar ishga kirganini noyob holda sanash:
SELECT COUNT(DISTINCT EXTRACT(YEAR FROM hire_date)) FROM employees;

-- 38. Buyurtmalar jadvalida nechta noyob sana borligini aniqlash:
SELECT COUNT(DISTINCT order_date) FROM orders;

-- 39. Noyob statuslar sonini hisoblash:
SELECT COUNT(DISTINCT status) FROM customers;

-- 40. Har bir shahardagi noyob statuslar sonini aniqlash:
SELECT city, COUNT(DISTINCT status) FROM customers GROUP BY city;

-- 41. Shahar nomi 'A' bilan tugaydigan mijozlarning noyob mamlakatlari:
SELECT DISTINCT country FROM customers WHERE city LIKE '%A' OR city LIKE '%a';

-- 42. Ismi 4 harfdan iborat xodimlarning noyob lavozimlari:
SELECT DISTINCT job_title FROM employees WHERE LENGTH(first_name) = 4;

-- 43. Maoshi juft son bo'lgan xodimlarning noyob maoshlari:
SELECT DISTINCT salary FROM employees WHERE MOD(salary, 2) = 0;

-- 44. Buyurtma summasi nol bo'lmagan noyob total_amount larni aniqlash:
SELECT DISTINCT total_amount FROM orders WHERE total_amount <> 0;

-- 45. Oxirgi 30 kunda berilgan buyurtmalarning noyob customer_id lari:
SELECT DISTINCT customer_id FROM orders WHERE order_date >= CURRENT_DATE - INTERVAL '30 days';

-- 46. Har bir dept_id dagi noyob maosh qiymatlari:
SELECT DISTINCT dept_id, salary FROM employees;

-- 47. Mijoz mamlakati va shahri birlashmasidan noyob manzillar:
SELECT DISTINCT CONCAT(city, ', ', country) AS full_address FROM customers;

-- 48. Lavozimida 'Manager' so'zi qatnashgan xodimlarning noyob maoshlari:
SELECT DISTINCT salary FROM employees WHERE job_title LIKE '%Manager%';

-- 49. Yil va oy kesimida noyob buyurtma sanalari:
SELECT DISTINCT EXTRACT(YEAR FROM order_date) AS order_year, EXTRACT(MONTH FROM order_date) AS order_month FROM orders;

-- 50. Xodimlarning bir xil ism va familiyaga ega bo'lmagan noyob to'liq ismlari:
SELECT DISTINCT CONCAT(first_name, ' ', last_name) AS full_name FROM employees;

-- 51. Xodimlarni maoshi bo'yicha o'sish (ASC) tartibida saralash:
SELECT * FROM employees ORDER BY salary ASC;
